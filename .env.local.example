# مفتاح Groq API المجاني (المحرك الأساسي فائق السرعة - اختياري):
GROQ_API_KEY=your_groq_api_key_here
# الموديل الافتراضي لـ Groq (llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile

# مفتاح Google Gemini API (المحرك الاحتياطي أو الأساسي):
GEMINI_API_KEY=your_gemini_api_key_here
# الموديل الافتراضي لـ Gemini (gemini-3.5-flash-lite):
# GEMINI_MODEL=gemini-3.5-flash-lite

# مفتاح الدرر السنية الرسمي (سيتم تفعيله لاحقًا بعد الحصول على إذن الدرر السنية):
DORAR_API_KEY=
